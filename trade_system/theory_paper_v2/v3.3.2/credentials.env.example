# Never commit real values. Export them only in the local process environment.

# No SEC account or API key is needed. The SEC requires a truthful, contactable
# project identifier, for example: Agent Trade Emotion research contact@example.com
SEC_USER_AGENT=

# Ordinary free developer keys / IDs. The interface remains closed when blank.
FRED_API_KEY=
EIA_API_KEY=
BEA_USER_ID=
YOUTUBE_API_KEY=
ALPHAVANTAGE_API_KEY=

# Optional runtime location; it is outside the V3.3.1 run store by default.
V332_DATA_ROOT=
